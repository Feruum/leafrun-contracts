    "/v1/jobs": {
      "post": {
        "description": "202 follows durable admission, confirmed activation of the snapshot pin and a durable workflow-start intent. Schema validation is asynchronous. Changed normalized inputs under the same key return 409. JSON normalization preserves numeric lexemes.",
        "operationId": "createJob",
        "parameters": [
          {
            "description": "Scoped to workspace and initiator; retained for seven days. Every replay rechecks current credentials and access.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "pattern": "^[^\\u0000\\r\\n]+$"
                },
                {
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                }
              ],
              "maxLength": 200,
              "minLength": 1,
              "type": "string",
              "x-max-utf8-bytes": 200
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          },
          "required": true,
          "x-max-bytes": 1048576
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
